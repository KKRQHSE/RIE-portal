NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only sleutel voor de service role (omzeilt RLS) — NOOIT NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server-only Resend-sleutel voor het versturen van mail — NOOIT NEXT_PUBLIC,
# uitsluitend in lib/resend.ts + de mail-routes onder app/api/mail/*.
RESEND_API_KEY=re_...

# Publieke basis-URL van het portaal; gebruikt om deellinks in mails op te
# bouwen (<site>/a/<token>). Zet dit in productie zodat links niet naar
# localhost wijzen. Zonder deze var valt de mail terug op VERCEL_URL of localhost.
NEXT_PUBLIC_SITE_URL=https://portaal.qhsetotaal.nl

# Server-only gedeeld geheim voor HANDMATIG/curl-testen van de heartbeat-route
# (POST /api/herinneringen/heartbeat, header 'x-heartbeat-secret') — NOOIT
# NEXT_PUBLIC. Los van CRON_SECRET hieronder: dit is niet wat de dagelijkse
# Vercel-cron gebruikt.
HEARTBEAT_SECRET=een-lang-willekeurig-geheim

# Server-only geheim voor de DAGELIJKSE Vercel-cron (zie vercel.json) die
# /api/herinneringen/heartbeat aanroept — GEEN eigen conventie, dit is Vercel's
# eigen naam: zodra deze variabele op het project staat (Vercel-dashboard →
# Settings → Environment Variables), stuurt Vercel 'm automatisch mee als
# 'Authorization: Bearer <CRON_SECRET>' bij elke cron-aanroep (GET, geen POST).
# Minstens 16 willekeurige tekens, zelfde soort geheim als HEARTBEAT_SECRET
# maar NIET hetzelfde — een gelekt testgeheim mag de cron-aanroep niet kunnen
# namaken en andersom.
CRON_SECRET=een-ander-lang-willekeurig-geheim

# --- AI-foto-analyse bij de werkplekinspectie (optioneel) ---
# Zonder deze sleutel werkt het portaal gewoon; het scherm meldt dan netjes dat
# AI-analyse nog niet is geconfigureerd. Server-only — NOOIT NEXT_PUBLIC, want
# de sleutel mag de browser nooit bereiken. Wordt alleen gelezen in lib/ai/* en
# app/api/inspectie/ai-analyse.
GROQ_API_KEY=gsk_...

# Welke leverancier-adapter wordt gebruikt (lib/ai/leverancier.ts). Nu alleen
# 'groq'; laat leeg voor de standaard. Wisselen van leverancier = een adapter
# erbij en deze waarde omzetten — de rest van de app verandert niet.
AI_LEVERANCIER=groq

# Welk Groq-model. Groq wisselt zijn aanbod regelmatig en het verschilt per
# account; laat leeg voor de standaard uit lib/ai/groq-bericht.ts. Kies een
# model met "image" in input_modalities (GET /openai/v1/models).
GROQ_MODEL=qwen/qwen3.8-27b
