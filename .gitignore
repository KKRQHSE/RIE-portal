# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# persoonlijk naslag (geen projectcode)
/RIE-portaal-overdracht.md

# lokale testdata-seed (geen projectcode)
/seed_testdata.sql

# lokaal gezondheidsrapport (geen projectcode)
/GEZONDHEID.md

# nachttest (lokaal, niet committen)
/test-nacht/

# RI&E-import: klantinhoud NIET committen (public repo).
# Alles in /import genegeerd, behalve de generieke pipeline-scripts.
# import/bedrijf.json (bedrijfs-/narratiefdata) blijft dus genegeerd = klantcontent.
/import/*
!/import/extract_docx.py
!/import/import_run.mjs
!/import/build_dataset.py
!/import/test_build_dataset_aantoonbaar.py

# Expliciet, ter bevestiging (bovenop /import/* hierboven — allebei de mogelijke
# padnamen, voor het geval de map ooit hernoemd wordt): Dutch Waste-brondata
# 6 sept 2026, echte klantdata, nooit committen.
/import/dutchwaste/
/import/dutchwaste-2026/

# Werkbestanden van een import-inventarisatie (gerenderde pdf-pagina's e.d. uit
# klantbronbestanden) — nooit committen, waar ze ook staan.
/scripts/_dw_check/
**/_dw_check/

# Lokale basislijn van de migratiecontrole (bevat bedrijfsnamen + checksums).
/scripts/.rie_aantoonbaar_basislijn.json

# Werkbestanden van de Supabase CLI (versiecache e.d.).
/supabase/.temp/

# Bron-RI&E's en gegenereerde klantdata, waar dan ook (defensief).
*.docx
*.doc
*.pdf
*.xlsx
*.xls
*.png
*.jpg
*.jpeg
!/public/logo.jpg
!/audit/**/*.png
/mnt/

# Python cache
__pycache__/
*.pyc
